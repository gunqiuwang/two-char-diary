/* pages/settings/settings.wxss */
.settings-page {
  position: relative;
  min-height: 100vh;
  padding: 0 40rpx calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow-x: hidden;
  font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  color: #37342f;
}

.paper-texture {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.018;
}

.status-bar,
.top-bar,
.setting-section {
  position: relative;
  z-index: 1;
}

.status-bar {
  width: 100%;
  flex-shrink: 0;
}

.top-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn,
.top-placeholder {
  width: 72rpx;
  height: 72rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 50%;
  transition: transform 160ms ease, background 160ms ease;
}

.back-btn:active {
  transform: scale(0.94);
  background: rgba(138, 126, 107, 0.07);
}

.back-arrow {
  position: relative;
  width: 32rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.back-arrow::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 5rpx;
  width: 17rpx;
  height: 17rpx;
  border-left: 1.5rpx solid #706b61;
  border-bottom: 1.5rpx solid #706b61;
  transform: rotate(45deg);
}

.back-arrow::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 12rpx;
  width: 25rpx;
  height: 1.5rpx;
  background: #706b61;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
}

.setting-section {
  width: 100%;
  margin-bottom: 30rpx;
}

.setting-title {
  display: block;
  margin: 0 0 14rpx 4rpx;
  font-size: 21rpx;
  color: #aaa49a;
  letter-spacing: 4rpx;
}

.bg-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.bg-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: transform 170ms ease;
}

.bg-card:active {
  transform: scale(0.96);
}

.bg-preview {
  position: relative;
  width: 120rpx;
  height: 160rpx;
  border: 2rpx solid #e2ded4;
  border-radius: 6rpx;
  box-shadow: 0 5rpx 16rpx rgba(67, 60, 49, 0.045);
  overflow: hidden;
}

.bg-preview::after {
  content: '';
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(180, 66, 52, 0.48);
  opacity: 0;
}

.bg-card.active .bg-preview {
  border-color: #8a7e6b;
  box-shadow: 0 0 0 3rpx rgba(138, 126, 107, 0.1), 0 8rpx 20rpx rgba(67, 60, 49, 0.06);
}

.bg-card.active .bg-preview::after {
  opacity: 1;
}

.bg-name {
  font-size: 20rpx;
  color: #8a8580;
  letter-spacing: 2rpx;
}

.bg-card.active .bg-name {
  color: #4a4843;
}

.setting-row-group,
.overview-card,
.setting-item {
  background: rgba(250, 249, 245, 0.9);
  border: 1rpx solid #e8e5dc;
  border-radius: 7rpx;
}

.setting-row-group {
  min-height: 86rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.setting-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.setting-label {
  font-size: 27rpx;
  color: #4a4843;
  line-height: 1.25;
}

.setting-caption {
  margin-top: 5rpx;
  font-size: 18rpx;
  color: #aaa49a;
  line-height: 1.35;
}

.segment-control {
  flex-shrink: 0;
  display: flex;
  padding: 4rpx;
  border: 1rpx solid #e0dbd1;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.42);
}

.segment-item {
  min-width: 70rpx;
  height: 48rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: 19rpx;
  color: #9a948a;
  box-sizing: border-box;
}

.segment-item.active {
  color: #f6f4ee;
  background: #6f695f;
  box-shadow: 0 3rpx 9rpx rgba(70, 65, 57, 0.16);
}

.overview-card {
  margin-bottom: 2rpx;
  padding: 20rpx 20rpx 16rpx;
}

.overview-main {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(138, 126, 107, 0.1);
}

.overview-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-number {
  font-size: 39rpx;
  font-weight: 300;
  color: #6c675f;
  line-height: 1;
}

.overview-label {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: #999288;
}

.overview-divider {
  width: 1rpx;
  height: 54rpx;
  background: rgba(138, 126, 107, 0.12);
}

.overview-meta-row {
  padding-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 19rpx;
  color: #999288;
}

.setting-item {
  position: relative;
  min-height: 84rpx;
  margin-bottom: 2rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  overflow: hidden;
  transition: transform 150ms ease, background 150ms ease;
}

.setting-item:active {
  transform: scale(0.993);
  background: rgba(247, 245, 239, 0.95);
}

.danger-item .setting-label {
  color: #b55346;
}

.setting-arrow {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.setting-arrow::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 1.5rpx solid #aaa49a;
  border-right: 1.5rpx solid #aaa49a;
  transform: rotate(45deg);
}

.share-btn {
  width: 100%;
  margin: 0 0 2rpx;
  font: inherit;
  color: inherit;
  line-height: normal;
  text-align: left;
}

.share-btn::after {
  border: none;
}

.dark-mode {
  color: #d0cec7;
}

.dark-mode .back-arrow::before {
  border-color: #96968d;
}

.dark-mode .back-arrow::after {
  background: #96968d;
}

.dark-mode .setting-title,
.dark-mode .setting-caption,
.dark-mode .overview-label,
.dark-mode .overview-meta-row,
.dark-mode .bg-name {
  color: #7e7a73;
}

.dark-mode .setting-row-group,
.dark-mode .overview-card,
.dark-mode .setting-item {
  background: #333330;
  border-color: #444440;
}

.dark-mode .setting-label,
.dark-mode .overview-number,
.dark-mode .bg-card.active .bg-name {
  color: #d0cec7;
}

.dark-mode .segment-control {
  border-color: #4b4b46;
  background: #2e2e2b;
}

.dark-mode .segment-item.active {
  color: #2a2a28;
  background: #bbb6ac;
}

.dark-mode .overview-main,
.dark-mode .overview-divider {
  border-color: rgba(190, 190, 180, 0.1);
  background-color: rgba(190, 190, 180, 0.1);
}

.dark-mode .bg-preview {
  border-color: #444440;
}

.dark-mode .bg-card.active .bg-preview {
  border-color: #8a7e6b;
}

@media (max-height: 720px) {
  .settings-page {
    padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  }

  .top-bar {
    height: 72rpx;
  }

  .setting-section {
    margin-bottom: 20rpx;
  }

  .setting-title {
    margin-bottom: 9rpx;
  }

  .bg-grid {
    margin-bottom: 14rpx;
  }

  .bg-preview {
    width: 106rpx;
    height: 142rpx;
  }

  .setting-row-group {
    min-height: 74rpx;
    padding-top: 12rpx;
    padding-bottom: 12rpx;
  }

  .overview-card {
    padding-top: 14rpx;
    padding-bottom: 12rpx;
  }

  .overview-main {
    padding-bottom: 11rpx;
  }

  .overview-meta-row {
    padding-top: 10rpx;
  }

  .setting-item {
    min-height: 70rpx;
    padding-top: 12rpx;
    padding-bottom: 12rpx;
  }
}
